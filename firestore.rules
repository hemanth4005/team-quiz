rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quizGames/{gameId}/scores/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'score', 'correct', 'total', 'finished', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 28
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1750
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 10
        && request.resource.data.total == 10
        && request.resource.data.finished is bool;
      allow delete: if false;
    }
  }
}